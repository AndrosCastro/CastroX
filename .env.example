# Copia este archivo como .env y cambia los valores

# Contraseña del usuario "sa" de SQL Server (mínimo 8 caracteres, con mayúsculas, minúsculas, números y símbolos)
DB_PASSWORD=CambiaEsta#Clave2026
DB_NAME=CastroX
DB_HOST_PORT=1433

# Clave secreta para firmar las sesiones (usa un texto largo y aleatorio)
JWT_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio
JWT_EXPIRES=12h

# Usuario administrador que se crea la primera vez
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# Puertos de la aplicación
APP_PORT=3000
APP_HTTPS_PORT=3443
ENABLE_HTTPS=true

# Crear productos de ejemplo la primera vez (true/false)
SEED_DEMO=true
